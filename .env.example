# Database (Postgres, e.g. from Neon or Supabase)
# Pooled connection, used by the app at runtime (Neon: the "-pooler" host)
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require&pgbouncer=true&connection_limit=10"
# Direct/unpooled connection, used only for migrations (Neon: same host without "-pooler")
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Paystack (test mode keys from your Paystack dashboard)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Base URL used for metadata/Open Graph (server-only, not exposed to the browser)
APP_URL="http://localhost:3000"
